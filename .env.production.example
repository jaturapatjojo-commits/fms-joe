# ==============================================================================
# FMS Web Platform - Production Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL)
# When running on Docker Desktop pointing to host machine:
# DATABASE_URL=postgresql://postgres:<password>@host.docker.internal:5432/ums_dev
# When running with dedicated PostgreSQL container:
# DATABASE_URL=postgresql://postgres:<password>@db:5432/ums_dev
DATABASE_URL=postgresql://postgres:password@host.docker.internal:5432/ums_dev

# NextAuth / Auth.js Secret (Must be strong 32+ bytes random base64 string)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-to-a-secure-random-32-bytes-base64-string

# Public URL of the application (used for OAuth callbacks and redirects)
APP_URL=http://localhost:3010

# Production Node Environment
NODE_ENV=production

# Email (SMTP) Configuration (Optional - leave empty to log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=App <no-reply@example.com>

# OAuth Credentials (Optional - leave empty if not used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
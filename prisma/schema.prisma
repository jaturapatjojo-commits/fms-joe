// VibeCore Framework Starter Kit. ตารางระดับแพลตฟอร์ม (ไม่มี tenant_id): users, permissions, auth_tokens, login_throttles
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  ALL
  CAMPUS
  ORG_UNIT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  /// { palette?: "blue"|"coral"|"pink"|"green"|"purple" }
  settings  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  roles       Role[]
  auditLogs   AuditLog[]
  sampleItems    SampleItem[]
  newsCategories NewsCategory[]
  newsArticles   NewsArticle[]
  departments    Department[]
  staffMembers   StaffMember[]
  curriculums    Curriculum[]
  educationLevels EducationLevel[]
  resources      Resource[]
  reservations   Reservation[]
  documents      Document[]
  documentApprovals DocumentApproval[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// เก็บตัวพิมพ์เล็กเสมอ
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  /// ชื่อที่แสดง
  name               String    @db.VarChar(255)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  /// credentials | google | microsoft
  provider           String    @default("credentials") @db.VarChar(20)
  providerId         String?   @map("provider_id") @db.VarChar(255)
  emailVerified      Boolean   @default(false) @map("email_verified")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// th | en | null (= ตามเบราว์เซอร์/ค่าเริ่มต้น)
  locale             String?   @db.VarChar(5)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  authTokens  AuthToken[]
  auditLogs   AuditLog[]   @relation("AuditActor")

  @@map("users")
}

model UserTenant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// A-Z 0-9 _ เช่น SUPER_ADMIN
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// แก้สิทธิ์/ลบไม่ได้ · SUPER_ADMIN ได้ทุกสิทธิ์โดยไม่ต้องมีแถวใน role_permissions
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// ผู้ใช้มีได้หลายแถว (หลายบทบาท / บทบาทเดียวหลายขอบเขต) · unique ที่มี scope_id null ไม่กันซ้ำใน Postgres — service ต้องเขียนแบบลบทั้งชุดแล้วสร้างใหม่
model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userTenantId String    @map("user_tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(ALL) @map("scope_type")
  /// campus_id หรือ org_unit_id หรือขอบเขตอื่นที่กำหนดเพิ่ม — null เมื่อ scope_type = ALL
  scopeId      String?   @map("scope_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userTenantId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

/// seed จาก src/permissions.ts ทุกครั้ง ไม่แก้ผ่าน UI
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// โทเคนใช้ครั้งเดียว — เก็บ sha256 ของโทเคน ไม่เก็บตัวจริง
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(128)
  /// EMAIL_VERIFY: { newEmail }
  payload   Json?        @db.JsonB
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?    @map("used_at") @db.Timestamptz()
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// กันเดารหัสผ่าน แทน Redis · key = "email:<lower>" หรือ "ip:<addr>"
model LoginThrottle {
  key         String    @id @db.VarChar(320)
  failCount   Int       @default(0) @map("fail_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("login_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// เช่น user.create, user.suspend, role.update
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// โมเดลตัวอย่าง (Sample CRUD) สำหรับให้นักเรียนดูเป็นแม่แบบในการพัฒนาฟีเจอร์ใหม่
model SampleItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sample_items")
}

/// หมวดหมู่ข่าวสารประชาสัมพันธ์
model NewsCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nameTh    String   @map("name_th") @db.VarChar(100)
  nameEn    String   @map("name_en") @db.VarChar(100)
  slug      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles NewsArticle[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("news_categories")
}

/// ข่าวสารและประกาศประชาสัมพันธ์คณะ
model NewsArticle {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  titleTh        String    @map("title_th") @db.VarChar(255)
  titleEn        String    @map("title_en") @db.VarChar(255)
  slug           String    @db.VarChar(255)
  summaryTh      String?   @map("summary_th") @db.Text
  summaryEn      String?   @map("summary_en") @db.Text
  contentTh      String    @map("content_th") @db.Text
  contentEn      String    @map("content_en") @db.Text
  coverImageUrl  String?   @map("cover_image_url") @db.VarChar(500)
  attachmentUrls Json      @default("[]") @map("attachment_urls") @db.JsonB
  /// DRAFT | PUBLISHED | ARCHIVED
  status         String    @default("DRAFT") @db.VarChar(20)
  isPinned       Boolean   @default(false) @map("is_pinned")
  viewCount      Int       @default(0) @map("view_count")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz()
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, isPinned])
  @@map("news_articles")
}

/// ภาควิชาหรือฝ่ายงานสังกัดคณะ
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nameTh    String   @map("name_th") @db.VarChar(150)
  nameEn    String   @map("name_en") @db.VarChar(150)
  code      String   @db.VarChar(50)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMembers StaffMember[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

/// บุคลากรและคณาจารย์ประจำคณะ
model StaffMember {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  departmentId     String?  @map("department_id") @db.Uuid
  prefixTh         String   @map("prefix_th") @db.VarChar(50)
  prefixEn         String   @map("prefix_en") @db.VarChar(50)
  firstNameTh      String   @map("first_name_th") @db.VarChar(100)
  lastNameTh       String   @map("last_name_th") @db.VarChar(100)
  firstNameEn      String   @map("first_name_en") @db.VarChar(100)
  lastNameEn       String   @map("last_name_en") @db.VarChar(100)
  academicPosition String?  @map("academic_position") @db.VarChar(100)
  adminPosition    String?  @map("admin_position") @db.VarChar(150)
  email            String?  @db.VarChar(255)
  phone            String?  @db.VarChar(50)
  roomNumber       String?  @map("room_number") @db.VarChar(50)
  avatarUrl        String?  @map("avatar_url") @db.VarChar(500)
  education        Json     @default("[]") @db.JsonB
  expertise        Json     @default("[]") @db.JsonB
  publications     Json     @default("[]") @db.JsonB
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive, sortOrder])
  @@index([tenantId, departmentId])
  @@map("staff_members")
}

/// หลักสูตรการศึกษาของคณะ
model Curriculum {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String   @db.VarChar(50)
  degreeLevel     String   @map("degree_level") @db.VarChar(50)
  nameTh          String   @map("name_th") @db.VarChar(255)
  nameEn          String   @map("name_en") @db.VarChar(255)
  degreeTh        String   @map("degree_th") @db.VarChar(255)
  degreeEn        String   @map("degree_en") @db.VarChar(255)
  revisionYear    Int      @map("revision_year")
  totalCredits    Int      @map("total_credits")
  studyYears      Int      @default(4) @map("study_years")
  tuitionFee      String?  @map("tuition_fee") @db.VarChar(100)
  descriptionTh   String?  @map("description_th") @db.Text
  descriptionEn   String?  @map("description_en") @db.Text
  careerPaths     Json     @default("[]") @map("career_paths") @db.JsonB
  studyPlan       Json     @default("[]") @map("study_plan") @db.JsonB
  syllabusFileUrl String?  @map("syllabus_file_url") @db.VarChar(500)
  isOpenAdmission Boolean  @default(true) @map("is_open_admission")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  majors CurriculumMajor[]

  @@unique([tenantId, code, revisionYear])
  @@index([tenantId, degreeLevel, isActive])
  @@map("curriculums")
}

/// สาขาวิชาภายใต้หลักสูตรการศึกษา
model CurriculumMajor {
  id              String   @id @default(uuid()) @db.Uuid
  curriculumId    String   @map("curriculum_id") @db.Uuid
  code            String?  @db.VarChar(50)
  nameTh          String   @map("name_th") @db.VarChar(255)
  nameEn          String   @map("name_en") @db.VarChar(255)
  degreeTh        String?  @map("degree_th") @db.VarChar(255)
  degreeEn        String?  @map("degree_en") @db.VarChar(255)
  descriptionTh   String?  @map("description_th") @db.Text
  descriptionEn   String?  @map("description_en") @db.Text
  careerPaths     Json     @default("[]") @map("career_paths") @db.JsonB
  studyPlan       Json     @default("[]") @map("study_plan") @db.JsonB
  syllabusFileUrl String?  @map("syllabus_file_url") @db.VarChar(500)
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@index([curriculumId, sortOrder])
  @@map("curriculum_majors")
}

/// ระดับการศึกษาของหลักสูตร (เช่น ปริญญาตรี, ประกาศนียบัตร, ปวส.)
model EducationLevel {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(150)
  nameEn    String   @map("name_en") @db.VarChar(150)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, sortOrder])
  @@map("education_levels")
}

/// ทรัพยากรห้องประชุมและยานพาหนะ
model Resource {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// ROOM | VEHICLE
  resourceType String   @map("resource_type") @db.VarChar(20)
  nameTh       String   @map("name_th") @db.VarChar(150)
  nameEn       String   @map("name_en") @db.VarChar(150)
  capacity     Int      @default(1)
  location     String?  @db.VarChar(255)
  details      String?  @db.Text
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([tenantId, resourceType, isActive])
  @@map("resources")
}

/// รายการขอจองห้องประชุมและยานพาหนะ
model Reservation {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  resourceId     String    @map("resource_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  startTime      DateTime  @map("start_time") @db.Timestamptz()
  endTime        DateTime  @map("end_time") @db.Timestamptz()
  passengerCount Int?      @map("passenger_count")
  destination    String?   @db.VarChar(255)
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status         String    @default("PENDING") @db.VarChar(20)
  rejectReason   String?   @map("reject_reason") @db.Text
  approvedById   String?   @map("approved_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, resourceId, startTime, endTime])
  @@index([tenantId, status])
  @@map("reservations")
}




/// เอกสารสารบรรณและบันทึกข้อความขออนุมัติ
model Document {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  documentNo   String    @map("document_no") @db.VarChar(50)
  title        String    @db.VarChar(255)
  /// MEMO | CIRCULAR | ORDER | PETITION | EXPENSE
  category     String    @default("MEMO") @db.VarChar(30)
  content      String?   @db.Text
  fileUrl      String?   @map("file_url") @db.VarChar(500)
  /// DRAFT | SUBMITTED | IN_REVIEW | APPROVED | REJECTED | CANCELLED
  status       String    @default("DRAFT") @db.VarChar(30)
  urgency      String    @default("NORMAL") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvals    DocumentApproval[]

  @@unique([tenantId, documentNo])
  @@index([tenantId, category, status])
  @@index([tenantId, userId])
  @@map("documents")
}

/// ลำดับการพิจารณาและการลงนามอนุมัติเอกสาร
model DocumentApproval {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  documentId   String    @map("document_id") @db.Uuid
  approverId   String    @map("approver_id") @db.Uuid
  stepOrder    Int       @default(1) @map("step_order")
  /// PENDING | APPROVED | REJECTED
  status       String    @default("PENDING") @db.VarChar(20)
  comment      String?   @db.Text
  actionAt     DateTime? @map("action_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, stepOrder])
  @@index([tenantId, approverId, status])
  @@map("document_approvals")
}
